    doc.loc.source = {"body":"#import \"~/graphql_shared/fragments/page_info.fragment.graphql\"\n#import \"~/graphql_shared/fragments/label.fragment.graphql\"\n\n# Top-level `restWorkItems @client` field is intercepted by the Apollo local resolver\n# (restWorkItemsResolver in work_items_rest_resolver.js), which fetches from the work items REST API.\n# Isolated from Query.namespace to prevent cache broadcast conflicts.\n# @feature_category: portfolio_management\nquery getWorkItemsRest(\n  $includeDescendants: Boolean = true\n  $iid: String\n  $fullPath: ID!\n  $isGroup: Boolean\n  $search: String\n  $sort: WorkItemSort\n  $state: IssuableState\n  $assigneeWildcardId: AssigneeWildcardId\n  $assigneeUsernames: [String!]\n  $authorUsername: String\n  $closedAfter: Time\n  $closedBefore: Time\n  $confidential: Boolean\n  $createdAfter: Time\n  $createdBefore: Time\n  $dueAfter: Time\n  $dueBefore: Time\n  $labelName: [String!]\n  $milestoneTitle: [String!]\n  $milestoneWildcardId: MilestoneWildcardId\n  $myReactionEmoji: String\n  $subscribed: SubscriptionStatus\n  $workItemTypeIds: [WorkItemsTypeID!]\n  $updatedAfter: Time\n  $updatedBefore: Time\n  $crmOrganizationId: String\n  $crmContactId: String\n  $releaseTag: [String!]\n  $releaseTagWildcardId: ReleaseTagWildcardId\n  $hierarchyFilters: HierarchyFilterInput\n  $in: [IssuableSearchableField!]\n  $not: NegatedWorkItemFilterInput\n  $or: UnionedWorkItemFilterInput\n  $ids: [WorkItemID!]\n  $afterCursor: String\n  $beforeCursor: String\n  $firstPageSize: Int\n  $lastPageSize: Int\n) {\n  namespace(fullPath: $fullPath) {\n    id\n    fullPath\n    name\n  }\n  restWorkItems(\n    isGroup: $isGroup\n    fullPath: $fullPath\n    ids: $ids\n    iid: $iid\n    includeDescendants: $includeDescendants\n    search: $search\n    sort: $sort\n    state: $state\n    assigneeUsernames: $assigneeUsernames\n    assigneeWildcardId: $assigneeWildcardId\n    authorUsername: $authorUsername\n    closedAfter: $closedAfter\n    closedBefore: $closedBefore\n    confidential: $confidential\n    createdAfter: $createdAfter\n    createdBefore: $createdBefore\n    dueBefore: $dueBefore\n    dueAfter: $dueAfter\n    labelName: $labelName\n    milestoneTitle: $milestoneTitle\n    milestoneWildcardId: $milestoneWildcardId\n    myReactionEmoji: $myReactionEmoji\n    subscribed: $subscribed\n    workItemTypeIds: $workItemTypeIds\n    updatedAfter: $updatedAfter\n    updatedBefore: $updatedBefore\n    crmContactId: $crmContactId\n    crmOrganizationId: $crmOrganizationId\n    releaseTag: $releaseTag\n    releaseTagWildcardId: $releaseTagWildcardId\n    hierarchyFilters: $hierarchyFilters\n    in: $in\n    not: $not\n    or: $or\n    after: $afterCursor\n    before: $beforeCursor\n    first: $firstPageSize\n    last: $lastPageSize\n  ) @client {\n    pageInfo {\n      ...PageInfo\n    }\n    nodes {\n      id\n      author {\n        id\n        avatarUrl\n        name\n        username\n        webPath\n        webUrl\n      }\n      closedAt\n      confidential\n      createdAt\n      hidden\n      iid\n      userDiscussionsCount\n      namespace {\n        id\n        fullPath\n      }\n      reference(full: true)\n      title\n      titleHtml\n      updatedAt\n      webPath\n      webUrl\n      state\n      userPermissions {\n        updateWorkItem\n      }\n      widgets(\n        onlyTypes: [\n          LABELS\n          ASSIGNEES\n          MILESTONE\n          START_AND_DUE_DATE\n          HIERARCHY\n          AWARD_EMOJI\n          DEVELOPMENT\n        ]\n      ) {\n        type\n        ... on WorkItemWidgetLabels {\n          allowsScopedLabels\n          labels {\n            nodes {\n              ...Label\n            }\n          }\n        }\n        ... on WorkItemWidgetAssignees {\n          assignees {\n            nodes {\n              id\n              avatarUrl\n              name\n              username\n              webUrl\n              webPath\n            }\n          }\n        }