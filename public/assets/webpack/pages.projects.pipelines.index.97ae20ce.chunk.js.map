    doc.loc.source = {"body":"#import \"~/graphql_shared/fragments/ci_icon.fragment.graphql\"\n#import \"~/graphql_shared/fragments/page_info.fragment.graphql\"\n\nquery getPipelines(\n  $fullPath: ID!\n  $first: Int\n  $last: Int\n  $prevPageCursor: String = \"\"\n  $nextPageCursor: String = \"\"\n) {\n  project(fullPath: $fullPath) {\n    id\n    pipelines(first: $first, last: $last, after: $nextPageCursor, before: $prevPageCursor) {\n      nodes {\n        id\n        iid\n        detailedStatus {\n          ...CiIcon\n        }\n        createdAt\n        finishedAt\n        duration\n        name\n        ref\n        refPath\n        refText\n        commit {\n          id\n          name\n          sha\n          shortId\n          title\n          webUrl\n          author {\n            id\n            avatarUrl\n            webPath\n            name\n          }\n        }\n        user {\n          id\n          name\n          webPath\n          avatarUrl\n        }\n        source\n        latest\n        yamlErrors\n        failureReason\n        configSource\n        stuck\n        type\n        path\n        stages {\n          nodes {\n            id\n            name\n            status\n          }\n        }\n        mergeRequest {\n          id\n          iid\n          webPath\n          title\n        }\n        mergeRequestEventType\n      }\n\n      pageInfo {\n        ...PageInfo\n      }\n    }\n  }\n}\n","name":"GraphQL request","locationOffset":{"line":1,"column":1}};
  

