    doc.loc.source = {"body":"# @feature_category: custom_dashboards_foundation\n\n# Flattens the whole tree beneath the group: `includeSubgroups` reaches projects at any depth,\n# and each carries its own `namespace` so a row can name the subgroup it actually sits in.\nquery getAnalyticsDashboardSubgroupProjects($fullPath: ID!, $after: String) {\n  group(fullPath: $fullPath) {\n    id\n    projects(\n      first: 20\n      after: $after\n      sort: ACTIVITY_DESC\n      includeArchived: false\n      includeSubgroups: true\n    ) {\n      nodes {\n        id\n        name\n        fullName: nameWithNamespace\n        fullPath\n        userPermissions {\n          readProAiAnalytics @gl_introduced(version: \"19.5.0\")\n        }\n        namespace {\n          id\n          name\n          fullPath\n        }\n      }\n      pageInfo {\n        hasNextPage\n        endCursor\n      }\n    }\n  }\n}\n","name":"GraphQL request","locationOffset":{"line":1,"column":1}};
  

    var names = {};
