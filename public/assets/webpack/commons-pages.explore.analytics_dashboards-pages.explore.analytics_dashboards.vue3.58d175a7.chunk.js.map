    doc.loc.source = {"body":"# @feature_category: custom_dashboards_foundation\n\n# Both connections are limited to what the user belongs to.\n#\n# The projects connection excludes archived results via `archived: EXCLUDE`. `Query.groups` has\n# no `archived` argument, so `active: true` is the nearest available filter, and it only drops\n# groups pending deletion.\n#\n# Capped at 20 per kind, matching the browse connections. Results are relevance-ordered, so\n# what matters is the top of the list, and a dropdown cannot show hundreds of rows anyway.\n#\n# `Query.projects` already ranks by similarity whenever `search` is given, but `Query.groups`\n# defaults to `name_asc`, so the groups half asks for it explicitly. `allAvailable: false` is\n# what makes it eligible: similarity is refused on scopes not bounded by membership.\nquery searchAnalyticsDashboardNamespacesGlobal($search: String!) {\n  groups(first: 20, search: $search, allAvailable: false, active: true, sort: \"similarity\") {\n    nodes {\n      id\n      name\n      fullName\n      fullPath\n      userPermissions {\n        readProAiAnalytics @gl_introduced(version: \"19.5.0\")\n      }\n      # Aliased so both result types expose their parent under the same key.\n      namespace: parent {\n        id\n        name\n        fullPath\n      }\n    }\n  }\n  projects(\n    first: 20\n    search: $search\n    membership: true\n    searchNamespaces: true\n    archived: EXCLUDE\n  ) {\n    nodes {\n      id\n      name\n      fullName: nameWithNamespace\n      fullPath\n      userPermissions {\n        readProAiAnalytics @gl_introduced(version: \"19.5.0\")\n      }\n      namespace {\n        id\n        name\n        fullPath\n      }\n    }\n  }\n}\n","name":"GraphQL request","locationOffset":{"line":1,"column":1}};
  

    var names = {};
    function unique(defs) {
